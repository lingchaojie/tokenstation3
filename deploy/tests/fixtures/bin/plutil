#!/bin/sh

set -eu

if [ "${1-}" != "-extract" ]; then
    echo "Unsupported fake plutil command: $*" >&2
    exit 1
fi

path=${2-}
payload=$(sed -n '1p')

case "$path" in
    0.configuration.labels)
        label=$(printf '%s\n' "$payload" | sed -n 's/.*"org\.sub2api\.stack":"\([^"]*\)".*/\1/p')
        [ -n "$label" ] || exit 1
        printf '{"org.sub2api.stack":"%s"}\n' "$label"
        ;;
    0.status.networks.0.ipv4Address)
        address=$(printf '%s\n' "$payload" | sed -n 's/.*"ipv4Address":"\([^"]*\)".*/\1/p')
        [ -n "$address" ] || exit 1
        printf '%s\n' "$address"
        ;;
    *)
        echo "Unsupported fake plutil extraction: $path" >&2
        exit 1
        ;;
esac
